# Added: REDIS_URL, MEMORY_SHORT_TTL, MEMORY_MID_TTL, MEMORY_RETRIEVAL_THRESHOLD
# Original: .env.example.orig
# =+=
# ===================== LLM 多模型切换 =====================
# 选择当前激活的模型供应商：deepseek | openai | qwen | moonshot | custom
# 切换只需改 LLM_PROVIDER 并填好对应供应商的 *_API_KEY；其余供应商留空即可。
LLM_PROVIDER=deepseek

# —— DeepSeek（默认）——
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# —— OpenAI 兼容（GPT-4o 等）——
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# —— 通义千问（阿里云百炼，OpenAI 兼容）——
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# —— Kimi / Moonshot（OpenAI 兼容）——
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# —— 高并发兜底链（升级 3）——
# 主供应商（LLM_PROVIDER）被限流/报错时，自动按顺序切换备用供应商，避免 429 雪崩。
# 取值为供应商名列表，留空表示不切换、只重试主供应商。逗号分隔，顺序即优先级。
LLM_FALLBACK_PROVIDERS=openai,qwen

# 通用兜底（custom 模式或覆盖任意供应商默认值）：
# LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# Embedding 配置
# 默认本地 HuggingFace BGE-M3（零成本、零泄露）。需线上：EMBEDDER_TYPE=openai + EMBEDDING_API_KEY
EMBEDDER_TYPE=huggingface
HF_MODEL_NAME=BAAI/bge-m3
HF_CACHE_DIR=./model_cache
# 线上 embedding（可选，EMBEDDER_TYPE=openai 时生效）：火山方舟/豆包 openai 兼容端点
# EMBEDDING_API_KEY=your-volces-key
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL=ep-m-20251117205847-trwgz

# ChromaDB 持久化路径
CHROMA_PERSIST_DIR=./chroma_db

# 文档存储路径
DOCUMENTS_DIR=./data

# Redis 配置（可选，不配置则使用内存存储）
REDIS_URL=redis://localhost:6379/0

# 记忆系统配置
MEMORY_SHORT_TTL=7200          # 短期记忆过期时间（秒）
MEMORY_MID_TTL=86400           # 中期记忆过期时间（秒）
MEMORY_RETRIEVAL_THRESHOLD=0.25 # 长期记忆检索相似度阈值
# 遗忘机制配置
MEMORY_FORGETTING_THRESHOLD=0.15          # 记忆遗忘阈值（低于此值自动清理）

# Worker 配置
WORKER_NUM=2                               # 影子 Worker 线程数
# Docker 部署说明：
# 1. 复制 .env.example 为 .env，填入 LLM_API_KEY
# 2. 运行: docker compose up -d
# 3. 访问: http://localhost:8000
# 注意: Docker 部署时 REDIS_URL 会自动指向 redis 容器
#       LLM_API_KEY 必须配置，否则 AI 功能不可用

# 管理员重置密钥（忘记密码自救，登录界面「忘记密码？」使用，请改成你自己的随机串）
ADMIN_RESET_KEY=change-me-admin-reset-key